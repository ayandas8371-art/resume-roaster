# Environment Variables for Roast My Resume
# Copy this file to .env.local and fill in the values

# ============================================
# CLERK AUTHENTICATION
# ============================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ============================================
# SUPABASE
# ============================================
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================
# AI - OPENROUTER (Primary)
# ============================================
OPENROUTER_API_KEY=
# Default model - can be changed to any OpenRouter model
OPENROUTER_MODEL=deepseek/deepseek-chat

# ============================================
# AI - NVIDIA NIM (Free fallback)
# ============================================
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct

# ============================================
# REVENUECAT
# ============================================
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
NEXT_PUBLIC_REVENUECAT_API_KEY= # Provided: test_TovBDMXRzRoIRLiqaEbNLvZqMLH

# ============================================
# RESEND EMAIL
# ============================================
RESEND_API_KEY= # Provided: re_eTbTsvCy_GyQ3Cri4vdYiasZNuZG4ngr6

# ============================================
# POSTHOG ANALYTICS
# ============================================
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ============================================
# APP CONFIG
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
